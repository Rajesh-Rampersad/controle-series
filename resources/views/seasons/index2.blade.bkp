    @push('scripts')
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Tooltips initialization
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
            var tooltipList = tooltipTriggerList.map(function(tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl)
            })

            // Episode deletion using Fetch API
            document.querySelectorAll('.delete-episode-btn').forEach(button => {
                button.addEventListener('click', function() {
                    const episodeId = this.dataset.episodeId;
                    const deleteRoute = this.dataset.route;

                    if (confirm('Tem certeza que deseja excluir este episódio?')) {
                        fetch(deleteRoute, {
                                method: 'POST', // Laravel uses POST with _method for DELETE
                                headers: {
                                    'X-CSRF-TOKEN': '{{ csrf_token() }}', // Laravel's CSRF token
                                    'Content-Type': 'application/json',
                                    'X-HTTP-Method-Override': 'DELETE' // Tells Laravel it's a DELETE request
                                },
                                body: JSON.stringify({}) // Empty body for DELETE request
                            })
                            .then(response => {
                                if (!response.ok) {
                                    return response.json().then(error => {
                                        throw new Error(error.message || 'Erro ao excluir o episódio.')
                                    });
                                }
                                return response.json();
                            })
                            .then(data => {
                                alert(data.message || 'Episódio excluído com sucesso!');
                                this.closest('li').remove(); // Visually remove the episode from the list
                            })
                            .catch(error => {
                                alert('Erro: ' + error.message);
                                console.error('Error:', error);
                            });
                    }
                });
            });

            // Optional: Live update of watched status text (without form submission)
            document.querySelectorAll('.form-check-input[type="checkbox"]').forEach(checkbox => {
                checkbox.addEventListener('change', function() {
                    const label = this.nextElementSibling; // The label for the checkbox
                    if (this.checked) {
                        label.innerHTML = '<i class="fas fa-check-circle me-1"></i> Visto';
                        label.classList.remove('text-muted');
                        label.classList.add('text-success');
                    } else {
                        label.innerHTML = '<i class="fas fa-times-circle me-1"></i> Não visto';
                        label.classList.remove('text-success');
                        label.classList.add('text-muted');
                    }
                });
            });
        });
    </script>
    @endpush

